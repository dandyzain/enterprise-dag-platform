# ---------------------------------------------------------------------------
# NexusFlow environment. Copy to `.env` and fill in real values.
# Secrets marked REQUIRED must be set in production (the app refuses to sign
# sessions / encrypt credentials without them).
# ---------------------------------------------------------------------------

# PostgreSQL (without it the app runs on a NON-durable in-memory store)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_dag?schema=public"

# Redis for BullMQ + live execution events (optional; falls back to an in-process runner)
REDIS_URL="redis://localhost:6379"

# REQUIRED in production — signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=""

# REQUIRED — AES-256-GCM master key for the credential vault (64 hex chars).
# Generate: openssl rand -hex 32   (changing it makes existing credentials unreadable)
ENCRYPTION_MASTER_KEY=""

# Public base URL (used for invite links, OG metadata, HSTS / upgrade-insecure-requests on https)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public demo accounts (admin/editor/viewer@enterprise.io, password "Password123!") confined
# to an isolated demo workspace. Default: on in development, off in production.
DEMO_MODE="true"

# Run the cron scheduler in this process (default true). Set "false" on the web service when
# the separate worker (`pnpm worker`) runs it, and on serverless hosts.
SCHEDULER_ENABLED="true"

# Protects GET /api/cron/tick for serverless schedulers (e.g. Vercel Cron, external cron).
CRON_SECRET=""

# Optional: debug | info | warn | error (JSON logs in production)
LOG_LEVEL="info"
